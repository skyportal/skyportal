{#- Render config prose as JSX text: escape the characters JSX treats specially,
    then expand {Name} placeholders into links from the paragraph's `links` map. -#}
{%- macro jsx(text, links={}) -%}
{%- set ns = namespace(t = text | trim
      | replace("&", "&amp;") | replace("'", "&apos;")
      | replace('"', "&quot;") | replace(">", "&gt;") | replace("<", "&lt;")) -%}
{%- for name, url in (links or {}).items() -%}
{%- set ns.t = ns.t | replace("{" ~ name ~ "}", '<a href="' ~ url ~ '">' ~ name ~ "</a>") -%}
{%- endfor -%}
{{ ns.t }}
{%- endmacro -%}
{%- set instances = namespace(current=none, others=[]) -%}
{%- for instance in app.about.instances or [] -%}
{%- if instance.name | lower == app.title | lower -%}
{%- set instances.current = instance -%}
{%- else -%}
{%- set instances.others = instances.others + [instance] -%}
{%- endif -%}
{%- endfor -%}
