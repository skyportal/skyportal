export const AboutIntro = () => {
  const { data: sysInfo } = useGetSysInfoQuery();

  return (
    <AboutCard title="About {{ app.title }}">
{%- if instances.current and instances.current.description %}
      <Typography variant="body1">
        {{ jsx(instances.current.description) }}
      </Typography>
{%- endif %}
      <Typography variant="body1">
        This is {{ app.title }}&nbsp;
        <code>v{sysInfo?.version}</code>. See the{" "}
        <Link component={RouterLink} to="/deployments">
          deployment history
        </Link>{" "}
        for what changed and when.
      </Typography>
      <Typography variant="body1">
        {{ jsx(app.about.description) }}
      </Typography>
{%- for paragraph in app.about.extra_paragraphs %}
      <Typography variant="body1">
        {{ jsx(paragraph.text, paragraph.links) }}
      </Typography>
{%- endfor %}
      <LinkPills
        homepage="{{ app.about.homepage_url }}"
        docs="{{ app.about.docs_url }}"
        api="{{ app.about.api_docs_url }}"
        repository="{{ app.about.repository_url }}"
      />
      <Typography variant="body2" color="text.secondary">
        To use the API, generate a token from your{" "}
        <Link component={RouterLink} to="/profile">
          profile
        </Link>{" "}
        page. Please file issues on GitHub.
      </Typography>
    </AboutCard>
  );
};

export const AboutInstances = () => (
{%- if instances.others %}
  <Stack spacing={2}>
    <SectionTitle>{{ "Other instances" if instances.current else "Instances" }}</SectionTitle>
    <InstanceBlocks instances={ {{ instances.others | tojson }} } />
  </Stack>
{%- else %}
  null
{%- endif %}
);

export const AboutTeam = () => (
  <AboutCard title="SkyPortal dev team">
    <TeamGrid people={ {{ (app.about.developers or []) | tojson }} } />
{%- if app.about.alumni %}
    <SectionTitle>Alumni</SectionTitle>
    <TeamGrid people={ {{ app.about.alumni | tojson }} } />
{%- endif %}
  </AboutCard>
);

export const AboutCitations = () => (
