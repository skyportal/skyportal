import { ResponsiveGridLayout, useContainerWidth } from "react-grid-layout";
import "reactgridlayoutcss/styles.css";
import "reactresizablecss/styles.css";

import { useTheme } from "@mui/material/styles";
import { makeStyles } from "tss-react/mui";
import IconButton from "@mui/material/IconButton";
import CachedIcon from "@mui/icons-material/Cached";
import Tooltip from "@mui/material/Tooltip";
import convertLength from "convert-css-length";

import {
  useGetProfileQuery,
  useUpdateUserPreferencesMutation,
} from "../../ducks/profile";
import { useGetGroupsQuery } from "../../ducks/groups";

{# Only process widgets that are set to show on the homepage, or those that don't have a show property #}
{%- set visible_widgets = {} -%}
{%- for name, props in app.homepage_widgets.items() if props.show | default(true) -%}
{%- set _ = visible_widgets.update({name: props}) -%}
{%- endfor -%}


{%- for widgetName, widgetProps in visible_widgets.items() %}
{%- if widgetName == "GroupList" %}
import {{ widgetName }} from "../group/{{ widgetName }}";
{%- else %}
import {{ widgetName }} from "../widget/{{ widgetName }}";
{%- endif %}
{%- endfor %}

const useStyles = makeStyles()(() => ({
  widgetIcon: {
    float: "right",
    color: "gray",
    margin: "0.25rem 0.25rem 0.25rem 0.25rem",
    "&:hover": {
      cursor: "pointer",
    },
  },
  widgetPaperDiv: {
    padding: "1rem",
    height: "100%",
    display: "flex",
    flexFlow: "column nowrap",
  },
  widgetPaperFillSpace: {
    height: "100%",
  },
}));

const defaultLayouts: any = {
  {%- for breakpoint in app.homepage_grid.breakpoints.keys() %}
  {{ breakpoint }}: [
    {%- for widgetName, widgetProps in visible_widgets.items() %}
    { i: "{{ widgetName }}", x: {{ widgetProps.layouts[breakpoint][0] }}, y: {{ widgetProps.layouts[breakpoint][1] }}, w: {{ widgetProps.layouts[breakpoint][2] }}, h: {{ widgetProps.layouts[breakpoint][3] }}, isResizable: {{ widgetProps.resizeable | lower }},
    {%- if widgetProps.minW is defined -%} minW: {{ widgetProps.minW }} {%- endif -%}},
    {%- endfor %}
  ],
  {%- endfor %}
}

const gridCols: any = {{ app.homepage_grid.cols|tojson }}

const geometry = (items: any[] = []) =>
  JSON.stringify(items.map(({ i, x, y, w, h }: any) => [i, x, y, w, h]));

const withSavedPositions = (saved: any) =>
  Object.fromEntries(
    Object.entries(defaultLayouts).map(([breakpoint, items]: [string, any]) => {
      const savedItems: any[] = saved?.[breakpoint] ?? [];
      if (savedItems.length === 0) return [breakpoint, items];
      // New widgets go below the saved layout: at their default spot they shove it around.
      let nextX = 0;
      let nextY = Math.max(...savedItems.map((s: any) => s.y + s.h));
      let rowHeight = 0;
      return [
        breakpoint,
        items.map((item: any) => {
          const savedItem = savedItems.find((s: any) => s.i === item.i);
          if (savedItem) {
            const { x, y, w, h } = savedItem;
            return { ...item, x, y, w, h };
          }
          if (nextX + item.w > gridCols[breakpoint]) {
            nextX = 0;
            nextY += rowHeight;
            rowHeight = 0;
          }
          const placed = { ...item, x: nextX, y: nextY };
          nextX += item.w;
          rowHeight = Math.max(rowHeight, item.h);
          return placed;
        }),
      ];
    }),
  );

const HomePage = () => {
  const { classes } = useStyles();
  const [updateUserPreferences] = useUpdateUserPreferencesMutation();

  const rem = "{{ app.homepage_grid.row_height|default("9.375rem")}}";

  const theme = useTheme();
  const rootFont = theme.typography.htmlFontSize;
  const convert = convertLength(rootFont);
  const gridRowHeight = parseFloat(convert(rem, "px"));
  const groups = useGetGroupsQuery().data?.user ?? [];
  const { data: profile } = useGetProfileQuery();
  const currentLayouts = withSavedPositions(
    (profile?.preferences as any)?.layouts,
  );

  const layoutChangeHandler = (_: any, allLayouts: any) => {
    // The grid also fires this on mount, which would save a layout nobody chose.
    const changed = Object.entries(allLayouts).some(
      ([breakpoint, items]: [string, any]) =>
        geometry(items) !== geometry(currentLayouts[breakpoint]),
    );
    if (!changed) return;
    updateUserPreferences({ layouts: allLayouts });
  };

  // The container must render unconditionally: the effect gives up if the node is missing.
  const { width, containerRef, mounted } = useContainerWidth();

  const resetLayouts = () => updateUserPreferences({ layouts: defaultLayouts });

  return (
    <>
      <div ref={containerRef}>
      {profile?.username && mounted && (
      <ResponsiveGridLayout
        width={width}
        className="layout"
        layouts={currentLayouts}
        breakpoints={{ '{' + app.homepage_grid.breakpoints|tojson + '}' }}
        cols={gridCols}
        margin={[10, 10]}
        onLayoutChange={layoutChangeHandler}
        {% raw %}dragConfig={{ handle: ".dragHandle" }}{% endraw %}
        rowHeight={gridRowHeight}
      >
        {%- for widgetName, widgetProps in visible_widgets.items() %}
          {%- if widgetName == "GroupList" %}
        <div key="{{ widgetName }}">
          <{{ widgetName }}
            variant="widget"
            groups={groups}
            {%- for key, value in widgetProps.props.items() -%}
            {%- if value is string %}
            {{ key }}={"{{ value }}"}
            {%- elif value is boolean %}
            {{ key }}={ {{ value | lower }} }
            {%- else -%}
            {{ key }}={ {{ value }} }
            {%- endif -%}
            {%- endfor %}
          />
        </div>
            {%- else %}
        <div key="{{ widgetName }}">
          <{{ widgetName }}
            classes={classes}
            {%- if widgetProps.props is defined %}
            {% for key, value in widgetProps.props.items() -%}
            {%- if value is string %}
            {{ key }}={"{{ value }}"}
            {%- elif value is boolean %}
            {{ key }}={ {{ value | lower }} }
            {%- else -%}
            {{ key }}={ {{ value }} }
            {%- endif -%}
            {%- endfor -%}
            {%- endif %}
          />
        </div>
          {%- endif -%}
        {%- endfor %}
      </ResponsiveGridLayout>
      )}
      </div>
      {profile?.username && (
      <Tooltip title="Reset page layout" placement="left">
        <IconButton
          onClick={resetLayouts}
          {% raw %}sx={{ position: "fixed", bottom: "1rem", right: "1rem" }}{% endraw %}
        >
          <CachedIcon />
        </IconButton>
      </Tooltip>
      )}
    </>
  );
};

export default HomePage;
