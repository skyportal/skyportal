import React from "react";
import embedVega from "../plot/vegaEmbed";
import { useTheme } from "@mui/material/styles";

const airmassSpec = (
  url: string,
  titleFontSize: number,
  labelFontSize: number,
): any => ({
  $schema: "https://vega.github.io/schema/vega-lite/v6.2.0.json",
  background: "transparent",
  width: "container",
  height: 300,
  autosize: { type: "fit-x", contains: "padding" },
  data: {
    url,
    format: {
      type: "json",
      property: "data", // where on the JSON does the data live
      parse: { date: "date" },
    },
  },
  title: "Hours Below Airmass {{ misc.hours_below_airmass_threshold }}",
  encoding: {
    y: {
      type: "quantitative",
      title: "hours",
      scale: {
        domain: [0, 12],
      },
      axis: {
        grid: true,
        titleFontSize,
        labelFontSize,
      },
    },
    x: {
      title: "date",
      type: "temporal",
      axis: {
        grid: true,
        format: "%b",
        formatType: "time",
        tickCount: "month",
        titleFontSize,
        labelFontSize,
      },
    },
  },
  layer: [
    {
      mark: { type: "line", clip: true, point: true },
      params: [
        {
          name: "zoom",
          select: { type: "interval", encodings: ["x"] },
          bind: "scales",
        },
      ],
      encoding: {
        x: { field: "date" },
        y: { field: "hours_below" },
        tooltip: [
          { field: "date", title: "Date", type: "temporal" },
          {
            field: "hours_below",
            type: "quantitative",
            title: "Hours Below Airmass {{ misc.hours_below_airmass_threshold }}",
          },
        ],
      },
    },
  ],
});

interface HoursBelowAirmassPlotProps {
  dataUrl: string;
}

// Jinja renders this file, so JSX double braces have to stay out of the markup.
const plotStyle = { width: "100%", minWidth: 360 };

const HoursBelowAirmassPlot = React.memo(
  (props: HoursBelowAirmassPlotProps) => {
    const { dataUrl } = props;
    const theme = useTheme() as any;
    return (
      <div
        style={plotStyle}
        ref={(node) => {
          if (node) {
            embedVega(
              node,
              airmassSpec(
                dataUrl,
                theme.plotFontSizes.titleFontSize,
                theme.plotFontSizes.labelFontSize,
              ),
              {
                actions: false,
              },
            );
          }
        }}
      />
    );
  },
);

HoursBelowAirmassPlot.displayName = "HoursBelowAirmassPlot";

export default HoursBelowAirmassPlot;
