      subitems:
        - name: Dashboard
          icon: Home
          url: /
          anonymous_ok: true

        - name: Sources
          icon: Storage
          url: /sources
          anonymous_ok: true

        - name: Candidates
          icon: Search
          url: /candidates

        - name: Brokers
          icon: Hub
          url: /brokers

        - name: Favorites
