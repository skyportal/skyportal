app:
  title: SkyPortal
  # Opening sentences of a source's acknowledgment block, before the facilities
  # and programs that source actually used are appended. Deployment-specific:
  # name the instance and the infrastructure behind it.
  acknowledgment: This work made use of SkyPortal (van der Walt et al. 2019).
  logos: # Logos to place in the top-left of the header/login page (zero or more)
    - src: /static/images/skyportal_logo_dark.png
      alt_text: Skyportal logo
  login_message: |
    For more information about the project, see
    <a href="https://github.com/skyportal/skyportal">
      https://github.com/skyportal/skyportal
    </a>
  # Artwork for the login page buttons. The buttons themselves come from
  # `server.auth.backends`, so a provider needs no entry here; add one, matched
  # on `url`, to replace that provider's text button with an image.
  login_buttons:
    - url: /login/google-oauth2
      image: /static/images/btn_google_signin_dark_normal_web.png
      alt_text: Click this image to log in

  # Copy for the About page; `title` above supplies the platform name.
  about:
    description: >-
      SkyPortal is an open source codebase that serves as a dynamic
      collaborative platform for time-domain astronomy. It is being jointly
      developed at Caltech, UC Berkeley, the University of Minnesota, and
      Université Paris-Saclay.
    homepage_url: https://skyportal.io
    docs_url: https://skyportal.io/docs/
    api_docs_url: https://skyportal.io/docs/api.html
    repository_url: https://github.com/skyportal/skyportal
    funding: >-
      SkyPortal development is funded by the Moore Foundation, Heising Simons
      Foundation, National Science Foundation, NASA and the Packard Foundation.
    # Paragraphs added after the description (zero or more). In `text`, a
    # {Name} placeholder becomes a link to the matching entry in `links`.
    extra_paragraphs: []
    # Repositories whose pull requests are linked above the changelog.
    changelog_repositories:
      - name: https://github.com/skyportal/skyportal/pulls
        url: https://github.com/skyportal/skyportal/pulls?q=is%3Apr+

  # Until accepted, every endpoint returns 403. `text` is markdown. Bumping
  # `version` makes everyone accept again; editing the text alone does not.
  # Give the terms either inline as `text` or as a path to a markdown file,
  # read once at startup. `text` wins if both are set.
  terms_of_service:
    enabled: false
    version: 1
    title: Terms of Service
    text: ""
    text_file: ""

  # Anonymous read-only access. When true, visitors who are not signed in are
  # served as `anonymous_user` (a "View only" account) so pages render without a
  # login. Write endpoints still 401 because that account holds no write ACLs.
  # The account is auto-provisioned (in the public group) when this is enabled.
  anonymous_access: false
  anonymous_user: anonymous

  # This secret key can be any random string of characters.
  # You should re-generate this for your application using:
  # base64.b64encode(os.urandom(50)).decode('ascii')
  secret_key: abc01234

  factory: skyportal.app_server.make_app

  # Threads each Tornado instance may use for blocking work. Too few lets a slow
  # upstream stall unrelated requests; too many can exhaust the database
  # connection pool. Unset uses Python's default.
  thread_pool_size:

  observation_plan:
    default_filters: ["ztfg", "ztfr", "ztfi"]
    use_skyportal_fields: True
    use_parallel: False
    Ncores: 1

  heasarc_endpoint: https://heasarc.gsfc.nasa.gov

  # this endpoint does not actually do anything -- it is just for testing
  sedm_endpoint: http://minar.caltech.edu/add_fritz
  sedmv2_endpoint:
  trt_endpoint: https://trt.narit.or.th/hub/api

  lt_host: 161.72.57.3
  lt_port: 8080

  lco_protocol: https
  lco_host: observe.lco.global
  lco_port: 443

  lco_archive_endpoint: https://archive-api.lco.global

  # The Tarot API is not publicly accessible.
  # To interact with it, we use a proxy hosted on the Icare instance of SkyPortal.
  # Access to the proxy requires an Icare account and a valid token specified in each allocation using the Tarot API.
  # This URL points to the Tarot API proxy endpoint:
  tarot_proxy_endpoint: https://skyportal-icare.ijclab.in2p3.fr/api/tarot_proxy

  # MMT API endpoint
  mmt_endpoint: https://scheduler.mmto.arizona.edu/APIv2

  # TTT API endpoint
  ttt_endpoint: https://dto.ttt.lightbridges.es/api

  ztf:
    protocol: https
    host: kowalski.caltech.edu
    port: 443

  ztf_forced_endpoint: https://ztfweb.ipac.caltech.edu

  fink_endpoint: https://fink-portal.org

  mpc_endpoint: https://minorplanetcenter.net

  swift:
    protocol: https
    host: www.swift.psu.edu
    port: 443

  swift_xrt_endpoint: https://www.swift.ac.uk/user_objects

  ps1_endpoint: https://catalogs.mast.stsci.edu/

  # PS1 cutout service used to scrape the public thumbnail link for an Obj.
  # Set to an empty string to skip the HTTP call and use the
  # "currently_unavailable.png" placeholder (useful in tests).
  ps1_cutout_url: http://ps1images.stsci.edu/cgi-bin/ps1cutouts
  skymapper_cutout_url: https://api.skymapper.nci.org.au/public/siap/dr4/query

  tess_endpoint: https://tess.mit.edu/public/tesstransients/

  atlas:
    protocol: https
    host: fallingstar-data.com
    port:

  kait:
    protocol: http
    host: herculesii.astro.berkeley.edu
    port:

  gemini:
    protocol: https
    north_prefix: gnodbtest # this is the test prefix, just remove 'test' for production
    south_prefix: gsodbtest # this is the test prefix, just remove 'test' for production
    domain: gemini.edu
    port: 8443

  treasuremap_endpoint: https://treasuremap.space

  tns:
    endpoint: https://sandbox.wis-tns.org
    bot_id:
    bot_name:
    api_key:
    look_back_days: 1

  hermes:
    endpoint: https://hermes.lco.global/api/v0 # Base URL of the Hermes API
    token: # Hermes API token for authentication (required to publish messages)
    topic: skyportal.skyportal # Kafka topic used to publish outgoing SkyPortal alerts to Hermes
    test_topic: skyportal.skyportal_test # Kafka topic used during testing
    sync:
      scimma_username: # SCiMMA/Kafka username for authentication
      scimma_password: # SCiMMA/Kafka password for authentication
      kafka_server: kafka.scimma.org
      from_start: False # Start from beginning of topic (True) or latest message (False)
      max_age_days: # Skip messages older than N days (null/empty = no limit)
      bot_user_id: # User ID of the bot account that will save sources and own photometry. If not set, the service will not start.
      group_ids: [] # List of group IDs to assign imported sources to
      instrument_tns_ids: # Whitelist of TNS instrument IDs whose photometry will be imported (see https://www.wis-tns.org/api/get/values). If not set, photometry import is skipped entirely.

  # Configuration for the WINTER and SPRING instruments.
  winter:
    protocol: http
    host: winter.caltech.edu
    port: 82
    submit_trigger: False # if False, the API POST call to WINTER and SPRING will only validate the payload

  gracedb_endpoint: https://gracedb.ligo.org/api/
  # See https://computing.docs.ligo.org/guide/auth/x509/ for example
  gracedb_credential:

  # See https://stackoverflow.com/a/35604855 for syntax
  # These are Javascript component routes
  routes:
    - path: "/"
      component: templates/HomePage
      exact: True
      anonymous_ok: true
    - path: "/sources"
      component: source/SourceList
      anonymous_ok: true
    - path: "/source/:id"
      component: source/Source
      anonymous_ok: true
    - path: "/source/:id/finder"
      component: FindingChart
      anonymous_ok: true
    - path: "/source/:id/periodogram"
      component: Periodogram
      anonymous_ok: true
    - path: "/source/:obj_id/analysis/:analysis_id"
      component: source/SourceAnalysisPage
      anonymous_ok: true
    - path: "/favorites"
      component: listing/FavoritesPage
    - path: "/data_access_requests"
      component: DataAccessRequestsPage
    - path: "/groups"
      component: group/Groups
    - path: "/group/:id"
      component: group/Group
    - path: "/teams"
      component: team/Teams
    - path: "/group_sources/:id"
      component: group/GroupSources
    - path: "/candidates"
      component: candidate/CandidateList
    - path: "/candidates/scan_reports"
      component: candidate/scan_reports/ReportsList
    - path: "/profile"
      component: user/Profile
    - path: "/brokers"
      component: broker/BrokerList
    - path: "/brokers/:brokerId"
      component: broker/Broker
    - path: "/brokers/:brokerId/filter/:fid"
      component: broker/BrokerFilterPage
    - path: "/user/:id"
      component: user/PublicProfile
    - path: "/upload_photometry/:id"
      component: photometry/UploadPhotometry
    - path: "/share_data/:id"
      component: source/ShareDataForm
    - path: "/filter/:fid"
      component: filter/Filter
    - path: "/about"
      component: About
      anonymous_ok: true
    - path: "/runs"
      component: observing_run/ObservingRunPage
    - path: "/run/:id"
      component: observing_run/RunSummary
    - path: "/allocations"
      component: allocation/AllocationList
    - path: "/allocation/:id"
      component: allocation/Allocation
    - path: "/instruments"
      component: instrument/InstrumentList
      anonymous_ok: true
    - path: "/instrument/:id"
      component: instrument/Instrument
      anonymous_ok: true
    - path: "/telescopes"
      component: telescope/TelescopeList
      anonymous_ok: true
    - path: "/telescope/:id"
      component: telescope/Telescope
      anonymous_ok: true
    - path: "/observations"
      component: observation/ObservationPage
    - path: "/galaxies"
      component: galaxy/GalaxyPage
      anonymous_ok: true
    - path: "/spatial_catalogs"
      component: spatial_catalog/SpatialCatalogPage
      anonymous_ok: true
    - path: "/followup_requests"
      component: followup_request/FollowupRequestPage
    - path: "/user_management"
      component: user/UserManagement
    - path: "/upload_spectrum/:id"
      component: spectrum/UploadSpectrum
    - path: "/observability/:id"
      component: source/Observability
      anonymous_ok: true
    - path: "/db_stats"
      component: DBStats
    - path: "/source_statistics"
      component: SourceStatistics
    - path: "/gcn_events"
      component: gcn/GcnEvents
      anonymous_ok: true
    - path: "/gcn_events/:dateobs"
      component: gcn/GcnEventPage
      anonymous_ok: true
    - path: "/mmadetectors"
      component: mma_detector/MMADetectorPage
    - path: "/earthquakes"
      component: earthquake/EarthquakesPage
      anonymous_ok: true
    - path: "/earthquakes/:event_id"
      component: earthquake/EarthquakePage
      anonymous_ok: true
    - path: "/services"
      component: analysis/AnalysisServicePage
    - path: "/analysis_requests"
      component: analysis/AnalysisRequestPage
    - path: "/recurring_apis"
      component: RecurringAPIPage
    - path: "/shifts"
      component: shift/ShiftNoId
    - path: "/shifts/:id"
      component: shift/ShiftWithId
    - path: "/summary_search"
      component: summary/SummarySearch
    - path: "/tag_management"
      component: TagManagement
    - path: "/taxonomies"
      component: taxonomy/TaxonomyList
    - path: "/sharing_services"
      component: sharing_service/SharingServicesPage
    - path: "/sharing_service/:id/submissions"
      component: sharing_service/SharingServiceSubmissionsPage
    - path: "/moving_objects/obsplan"
      component: moving_object/MovingObjectObsPlanPage

  sidebar:
