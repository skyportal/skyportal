          icon: Group
          permissions: ["Manage users", "System admin"]
          url: /user_management

  # See https://github.com/STRML/react-grid-layout for more on the grid package
  homepage_grid:
    # This section describes the grid on which Home Page widgets are laid out.
    #
    # The breakpoints describe screen sizes at which a different set of widget
    # layouts should be used. Note that these breakpoints describe minimum width
    # values, unlike the maximum width bounds used by Material UI breakpoints.
    # For example, a breakpoint of "sm: 650" will match windows with width 650px
    # or greater, until the next highest breakpoint is hit (probably a "md").
    # This is different from Material UI, where a breakpoint of 650 would match
    # window widths that are at most 650px.
    #
    # The cols describe the number of evenly spaced columns that make up the
    # grid at a given breakpoint. For example, on extra-large screens (greater
    # than ${breakpoints.xlg} pixels), the grid will use ${cols.xlg} columns of
    # equal width to describe sizes of widgets based on the layouts provided.
    #
    # Optionally, you may provide a "row_height: {a rem value}" property in
    # this section to change the height of a row on the grid. By default, this
    # value is 9.375rem (150px for the default 16px = 1rem configuration).

    breakpoints:
      xlg: 1400
      lg: 1150
      md: 996
      sm: 650
      xs: 0

    cols:
      xlg: 16
      lg: 12
      md: 10
      sm: 6
      xs: 4

  gcn_extraction_tags:
    # Taxonomy class reported by a circular extraction -> obj tag applied to the
    # objects of that event. An unmapped class tags nothing. The tag must already
    # exist as an ObjTagOption.
    X-ray Flash: XRFcandidate

  assistant:
    # Conversational assistant answering in a reserved comment channel. It reaches
    # the instance through SkyPortal's own MCP endpoint, so it gains a capability
    # whenever a tool is added there — nothing here is per-pipeline.
    # Leave base_url unset to disable the service.
    base_url: # e.g. https://host/llm/qwen3-27b/v1
    model: ""
    api_key: ""
    # Comments in this channel are addressed to the assistant; its replies carry
    # system=true so they never retrigger it.
    channel: assistant
    # Cap on tool round-trips per question, so a looping model cannot run away.
    max_tool_calls: 8
    # Oldest comments are dropped first when a thread outgrows this.
    max_context_comments: 40
    request_timeout: 300

  homepage_widgets:
    # This section describes the specific widgets shown on the Home Page and how
    # they are laid out by default on the grid of the page.
    #
    # The name of section should be the same as the widget's React component.
    #
    # The props property should be a set of properties to be passed on to the
    # underlying React component for the widget. You may run into cases in which
    # you must pass a more complex, dynamic property (perhaps fetched from the
    # application redux store). Since you can not know that in the time of the
    # configuration writing, such properties should be directly coded into the
    # HomePage.jsx.template file (see the GroupList widget for an example)
    #
    # By default, any widget listed here is shown on the Home Page. However, you
    # can give a widget the property "show: false" to turn off rendering of the
    # widget.
    #
    # The resizable property determines whether the user is able to resize the
    # widget after it has been rendered based on default layouts.
    #
    # Finally, the layouts property provides an array of default sizes/locations
    # for each screen width breakpoint for the given widget. Layout arrays are
    # given in the order [x, y, width, height], in units of grid columns/rows.
    # For example, a layout array of [1, 2, 3, 4] will render a widget 3 grid
    # columns in width, 4 grid rows in height, and have its upper-left corner at
    # the column 1 (zero-indexed) and row 2. Note that each row is by default
    # 150px in height. The row height can be altered in the homepage_grid
    # section above (as well as other grid characteristics).
    GettingStarted:
      # Onboarding checklist + guided tour. Shown to every user until they
      # dismiss it (persisted per-user); reopenable any time. Set show: false to
      # disable it for a deployment.
      resizeable: true
      minW: 2
      layouts:
        xlg: [0, 0, 4, 3]
        lg: [0, 0, 3, 3]
        md: [0, 0, 3, 3]
        sm: [0, 0, 6, 3]
        xs: [0, 0, 4, 3]

    WeatherWidget:
      resizeable: true
      minW: 2
      layouts:
        xlg: [10, 6, 6, 3]
        lg: [7, 6, 5, 3]
        md: [5, 9, 5, 3]
        sm: [0, 14, 6, 2]
        xs: [0, 24, 4, 2]

    SourceCounts:
      props:
        sinceDaysAgo: 7
      resizeable: true
      minW: 1.5
      layouts:
        xlg: [14, 0, 2, 1]
        lg: [10, 0, 2, 1]
        md: [7, 0, 3, 1]
        sm: [0, 3, 3, 2]
        xs: [0, 3, 4, 1]

    RecentSources:
      resizeable: true
      minW: 2
      layouts:
        xlg: [4, 0, 5, 3]
        lg: [3, 0, 4, 3]
        md: [3, 0, 4, 3]
        sm: [3, 5, 3, 3]
        xs: [0, 9, 4, 3]

    NewsFeed:
      resizeable: true
      minW: 2
      layouts:
        xlg: [0, 3, 5, 3]
        lg: [0, 3, 4, 3]
        md: [5, 3, 5, 3]
        sm: [0, 8, 3, 3]
        xs: [0, 12, 4, 3]

    NeedsAttention:
      # Open obligations rather than events: data another group has asked you
      # for and has not been answered, and objects you have scheduled that
      # another group has scheduled too.
      resizeable: true
      minW: 2
      layouts:
        xlg: [0, 6, 10, 3]
        lg: [0, 6, 7, 3]
        md: [0, 9, 5, 3]
        sm: [3, 11, 3, 3]
        xs: [0, 21, 4, 3]

    TopSources:
      resizeable: true
      minW: 2
      layouts:
        xlg: [9, 0, 5, 3]
        lg: [7, 0, 3, 3]
        md: [0, 3, 5, 3]
        sm: [0, 5, 3, 3]
        xs: [0, 6, 4, 3]

    TopSavers:
      resizeable: true
      minW: 3
      layouts:
        xlg: [11, 3, 5, 3]
        lg: [8, 3, 4, 3]
        md: [5, 6, 5, 3]
        sm: [3, 8, 3, 3]
        xs: [0, 15, 4, 3]

    RecentGcnEvents:
      resizeable: true
      minW: 3
      layouts:
        xlg: [5, 3, 6, 3]
        lg: [4, 3, 4, 3]
        md: [0, 6, 5, 3]
        sm: [0, 11, 3, 3]
        xs: [0, 18, 4, 3]

    # Use linkToGroupSources: true in props to link to the group sources page instead.
    GroupList:
      props:
        title: My Groups
      resizeable: true
      minW: 1.5
      layouts:
        xlg: [14, 1, 2, 2]
        lg: [10, 1, 2, 2]
        md: [7, 1, 3, 2]
        sm: [3, 3, 3, 2]
        xs: [0, 4, 4, 2]

    TelescopeMapWidget:
      show: False

database:
  database: skyportal
  host: localhost
  port: 5432
  user: skyportal
  password:

  # Superuser for `make db_init`; empty defaults to "postgres".
  admin_user:

  # Optional transaction-mode connection pooler (pgbouncer/pgcat) between the app
  # and Postgres, so many processes share a small bounded backend pool instead of
  # exhausting max_connections. Pooler-agnostic: point `host`/`port` at whichever
  # pooler you run (the bundled `pgbouncer` service, or an external one).
  pooler:
    enabled: false
    host: localhost
    port: 6432
    pool_mode: transaction
    # Real Postgres backend connections the pooler keeps per user/db.
    default_pool_size: 25
    max_client_conn: 1000
    # Seconds before the pooler force-closes a connection left idle in a
    # transaction; guards the pool against leaked transactions (0 = disabled).
    idle_transaction_timeout: 0

# Valkey connection. Valkey speaks the redis protocol, so a standard redis
# client talks to it directly; these keys are the redis client's host/port/db.
redis:
  host: localhost
  port: 6379
  db: 0

cache:
  # When false (default), `get_cache()` returns a no-op cache and nothing uses
  # Valkey — behavior is unchanged until caching is explicitly enabled.
  enabled: false
  ttl:
    # Default time-to-live (seconds) for cached entries when a caller does not
    # specify one.
    default: 300

# Optional: route the source page's photometry fetch through a custom endpoint
# (e.g. a broker passthrough that merges saved DB photometry with on-demand
# broker photometry). "{id}" is substituted with the object id; the endpoint
# must return the same response shape as /api/sources/{id}/photometry (a bare
# list of serialized points). Null (default) uses the standard endpoint.
# To display broker-augmented photometry, point this at the survey-addressed
# broker passthrough, e.g.:
#   photometry_display_endpoint: "/api/brokers/photometry/{id}?survey=ZTF"
photometry_display_endpoint:

server:
  # From https://console.developers.google.com/
  #
  # - Create Client ID
  # - Javascript origins: https://localhost:5000
  # - Authorized redirect URLs: http://localhost:5000/complete/google-oauth2/
  #
  # You need to have Google+ API enabled; it takes a few minutes to activate.
  host: localhost
  port: 5000 # This is the public-facing port

  # Whether the base URL is http or https
  ssl: False

  # According to the Tornado docs at
  # https://www.tornadoweb.org/en/stable/guide/running.html#processes-and-ports:
  #
  # Due to the Python GIL (Global Interpreter Lock), it is necessary
  # to run multiple Python processes to take full advantage of
  # multi-CPU machines. Typically it is best to run one process per
  # CPU.
  processes: 4

  # How many of the above processes should be dedicated to
  # frontend only (i.e., no token authorized API requests)
  dedicated_frontend_processes: 2

  # The max size of a request body in megabytes (M)
  max_body_size: 100

  # nginx parameter which sets both the time in seconds before which
  # the server is considered unavailable and the subsequent period of
  # time the server will be unavailable
  fail_timeout: 20

  # Rate limit: number of requests per second (see https://www.nginx.com/blog/rate-limiting-nginx/)
  rate_limit: 5
  # Rate limit burst size (https://www.nginx.com/blog/rate-limiting-nginx/#bursts)
  burst: 10

  # In addition to the local network, specify any IP addresses that are to be
  # exempt from API rate limiting
  whitelisted_ips: []

  # Specify IPs or address ranges (e.g., 130.211.0.0/22) that are associated
  # with upstream load balancing.
  # These trusted addresses are used to uncover the originating IP.
  loadbalancer_ips: []

  auth:
    debug_login: True
    google_oauth2_key:
    google_oauth2_secret:
    google_oauth2_timeout: 15

services:
  dask: False

# Alert brokers (BOOM, Kowalski, Fink, Lasair, ...) are configured at runtime as
# `Broker` database records (name + provider class + encrypted credentials), not
# here; see doc/broker_plugins.md. Providers are registered in
# skyportal/broker_apis/.
brokers:
  # Run the in-core ingestion service (services/broker_ingest): for each active
  # broker whose provider implements run_ingestion, consume its stream and ingest
  # alerts via the shared save transform. Off by default; interactive access
  # (the /brokers/{id} page) works regardless of this setting.
  ingest_enabled: False

  # Number of broker_ingest OS processes. Process 0 runs every broker; extra
  # processes run only providers whose ingestion is safe to replicate (Kafka
  # consumer groups, which Kafka rebalances) so REST pollers aren't duplicated.
  ingest_processes: 1

# BOOM-specific settings. The filter builder's user-created modules (variables,
# list variables, switch cases, blocks) live in BOOM's own MongoDB store, not in
# skyportal's database. Point this at that store, or set the equivalent
# `filter_modules_mongodb_uri`/`filter_modules_database` keys on the broker
# record's altdata; left unset, the builder shows no saved modules.
boom:
  filter_modules:
    mongodb_uri: null
    database: null

misc:
  days_to_keep_unsaved_candidates: 7
  days_to_keep_finding_charts_cache: 30
  minutes_to_keep_candidate_query_cache: 60
  minutes_to_keep_source_query_cache: 360 # 6 hours
  minutes_to_keep_annotations_info_query_cache: 360 # 6 hours
  minutes_to_keep_localization_instrument_query_cache: 1440 # 1 day
  max_items_in_localization_instrument_query_cache: 100
  minutes_to_keep_public_source_pages_cache: 1440 # 1 day
  minutes_to_keep_reports_cache: 1440 # 1 day
  max_seconds_to_sleep_reminders_service: 60
  max_seconds_to_sleep_recurring_apis_service: 60
  public_group_name: "Sitewide Group"
  # When a data product (photometry, spectra, ...) is uploaded without specifying
  # any groups, share it with the sitewide public group (public_group_name) in
  # addition to the uploader's single-user group (which is always included). When
  # false (default) an unspecified upload is shared only with the uploader. Groups
  # given explicitly on the upload are always honored as-is.
  share_data_with_public_group_by_default: false
  # External survey thumbnails fetched (outbound HTTP) when a source is saved.
  # Set to [] to disable, e.g. on instances without external network egress.
  external_thumbnail_types:
    - sdss
    - ps1
    - ls
  # Use a named cosmology from `astropy.cosmology.parameters.available` cosmologies
  # or supply the arguments for an `astropy.cosmology.FLRW` cosmological instance.
  # If {"flat": True} then use a subclass of the FLRW, called `FlatLambdaCMD`
  # otherwise use `LambdaCDM`. See `utils.cosmology.py` for the way in which
  # the user-supplied cosmology parameter set constructs the site-wide cosmology.
  cosmology: Planck18
  #cosmology: {H0: "65.0", Om0: 0.3, Ode0: 0.7, name: 'skyportal_user_cosmo'}

  dustmap: sfd
  # Vendored in the skyportal-data submodule so the SFD maps are present
  # without a network fetch at startup. obj.py still falls back to fetching
  # if the files are absent (e.g. submodule not initialized).
  dustmap_folder: skyportal-data/dustmaps

  # sncosmo cache (bandpasses, SED models, spectra), vendored in the
  # skyportal-data submodule. Pointing sncosmo here keeps app import off the
  # flaky SVO Filter Profile Service; any missing bandpass still falls back to
  # a network fetch into this directory.
  sncosmo_data_folder: skyportal-data/sncosmo

  # The minimum signal-to-noise ratio/ n-sigma for lim mag cacluations to
  # consider a photometry point as a detection
  photometry_detection_threshold_nsigma: 3.0

  # whether the frontend should show photometry validation information
  # and if the backend allows adding/editing/deleting it
  photometry_validation: True

  # The airmass value below which to track hours for when plotting
  # on an object's observability page
  hours_below_airmass_threshold: 2.9

  color_palette: turbo

weather:
  # time in seconds to wait before fetching weather for a given telescope
  refresh_time: 3600.0
  # Get an API key at OpenWeatherMap https://openweathermap.org/price
  # the free tier should be sufficient, as we cache the weather results
  # for each telescope
  openweather_api_key:

across:
  # NASA ACROSS joint-visibility integration. Uses the public, unauthenticated
  # ACROSS API to compute per-instrument visibility for a source; joint windows
  # are intersected locally. See https://across.sciencecloud.nasa.gov
  api_url: https://api.across.sciencecloud.nasa.gov/v1
  # hi_res=true routinely exceeds the ACROSS gateway timeout; keep it off.
  hi_res: False
  request_timeout: 20.0

external_logging:
  papertrail:
    # get an account at https://papertrailapp.com
    enabled: False
    # change url to the correct subdomain for your account
    # and change the port as well
    url:
    port:
    # which log files, if any do you not want to send over to the 3rd party?
    excluded_log_files: ["log/websocket_server.log"]
  sentry:
    endpoint:
    # Set traces_sample_rate to 1.0 to capture 100%
    # of transactions for performance monitoring.
    # Sentry recommends adjusting this value in production.
    traces_sample_rate: 0.25
    # Set profiles_sample_rate to 1.0 to profile 100%
    # of sampled transactions.
    # We recommend adjusting this value in production.
    profiles_sample_rate: 1.0

observability:
  # Enable OpenTelemetry instrumentation of the Tornado app and expose request
  # metrics in Prometheus format at /api/internal/metrics. The endpoint requires
  # a System admin token (scrape with `Authorization: token <id>`). Each app
  # worker serves its own metrics on its internal port (ports.app_internal +
  # worker number); point Prometheus at those ports directly rather than the
  # load-balanced public endpoint. Disabled by default.
  enabled: False
  service_name: skyportal

cron:
  # - interval: 60
  #  script: jobs/count_unsaved_candidates.py
  # - interval: 1440
  #   script: jobs/delete_unsaved_candidates.py
  #   limit: ["01:00", "02:00"]

twilio:
  # Twilio Sendgrid API configs
  # This needs to be set to a valid, Sendgrid-registered address in config.yaml
  from_email:
  # This needs to be obtained via Sendgrid setup on their site
  sendgrid_api_key:

  # Twilio SMS API configs
  # These values must be valid ones from the Twitter API console
  from_number:
  sms_account_sid:
  sms_auth_token:

smtp:
  from_email: # This is both the email used to authenticate with smtplib and the sender address
  password:
  host: smtp.gmail.com # Default Gmail settings; modify as needed
  port: 587 # Default Gmail settings; modify as needed

# This value needs to be either "sendgrid" or "smtp" (without quotes)
email_service:

invitations:
  enabled: False # If debug_login=True above, invite tokens won't be used during auth
  days_until_expiry: 3
  disable_emailing: False # If True, the app will generate invite tokens but not send emails
  email_subject: "You've been invited to collaborate on SkyPortal"
  email_body_preamble: | # This can include HTML tags
    Welcome to <b>SkyPortal</b>!
    <br />
    Some other text here.

notifications:
  enabled: True

standard_stars:
  ZTF: data/ztf_standards.csv
  ESO: data/eso_standards.csv

# Parameters for the thumbnail classification function which labels
# images as grayscale or colored. See utils/thumbnail.py for the function.
image_grayscale_params:
  thumb_size: 40
  MSE_cutoff: 22
  adjust_color_bias: True

slack:
  microservice_port: 64100
  expected_url_preamble: "https://hooks.slack.com/"

spectrum_types:
  types:
    - source
    - host
    - host_center
  default: source

cross_match:
  gaia:
    catalog: "gaiaedr3.gaia_source"
    radius: 2.0
    limmag: 20.5
    number: 1

# define the additional passbands that are not in SNCosmo
# (https://sncosmo.readthedocs.io/en/stable/bandpass-list.html)
# the names must be unique. The wavelength array should
# describe the full extent of the bandpass in Angstrom
# and the transmission should be a vector of the same
# length that defines the full Quantum Efficiency at each wavelength.
# must have at least two elements in the arrays
# `wavelength` and `transmission`.
additional_bandpasses:
  #  - name: 'atlasc'
  #    filterset: 'atlas'
  #    wavelength: [4150, 4157, 6556, 6560]
  #    transmission: [0, 1, 1, 0]
  #    description: "basic ATLAS C filter - tophat transmission"
  #  - name: 'atlaso'
  #    filterset: 'atlas'
  #    wavelength: [5580, 5582, 8249, 8250]
  #    transmission: [0, 1, 1, 0]
  #    description: "basic ATLAS O filter - tophat transmission"
  - name: "swiftxrt"
    filterset: "xrt"
    wavelength: [0.1, 1, 62, 100]
    transmission: [0, 1, 1, 0]
    description: "basic XRT filter - tophat transmission"
  - name: "nicerxti"
    filterset: "xti"
    wavelength: [0.1, 1.2, 41, 100]
    transmission: [0, 1, 1, 0]
    description: "basic XTI filter - tophat transmission"
  # Einstein Probe and SVOM. Wavelength is the energy band converted with
  # lambda[AA] = 12.398 / E[keV], following the swiftxrt and nicerxti entries.
  - name: "epwxt"
    filterset: "wxt"
    wavelength: [3.038, 3.1, 24.8, 25.29]
    transmission: [0, 1, 1, 0]
    description: "Einstein Probe WXT tophat, 0.5-4 keV"
  - name: "epfxt"
    filterset: "fxt"
    wavelength: [1.215, 1.24, 41.33, 42.15]
    transmission: [0, 1, 1, 0]
    description: "Einstein Probe FXT tophat, 0.3-10 keV"
  - name: "svommxt"
    filterset: "mxt"
    wavelength: [1.215, 1.24, 61.99, 63.23]
    transmission: [0, 1, 1, 0]
    description: "SVOM MXT tophat, 0.2-10 keV"
  - name: "svomeclairs"
    filterset: "eclairs"
    wavelength: [0.081, 0.08266, 3.1, 3.162]
    transmission: [0, 1, 1, 0]
    description: "SVOM ECLAIRs tophat, 4-150 keV"
  - name: "svomgrm"
    filterset: "grm"
    wavelength: [0.00243, 0.00248, 0.8266, 0.8431]
    transmission: [0, 1, 1, 0]
    description: "SVOM GRM tophat, 15 keV to 5 MeV"
  # SVOM's Visible Telescope is optical, with a blue and a red channel.
  - name: "svomvtb"
    filterset: "vt"
    wavelength: [4455, 4500, 6500, 6565]
    transmission: [0, 1, 1, 0]
    description: "SVOM VT blue channel tophat, 450-650 nm"
  - name: "svomvtr"
    filterset: "vt"
    wavelength: [6435, 6500, 10000, 10100]
    transmission: [0, 1, 1, 0]
    description: "SVOM VT red channel tophat, 650-1000 nm"
  # Radio is frequency-specified: wavelength(AA) = c / nu. Standard VLA bands,
  # plus the ATCA 3mm pair.
  - name: "radio-0.34GHz"
    filterset: "radio"
    wavelength: [8.641e+09, 8.685e+09, 8.95e+09, 8.994e+09]
    transmission: [0, 1, 1, 0]
    description: "VLA P-band tophat centered at 0.34 GHz"
  - name: "radio-1.4GHz"
    filterset: "radio"
    wavelength: [2.099e+09, 2.109e+09, 2.173e+09, 2.184e+09]
    transmission: [0, 1, 1, 0]
    description: "VLA L-band tophat centered at 1.4 GHz"
  - name: "radio-3GHz"
    filterset: "radio"
    wavelength: [9.793e+08, 9.843e+08, 1.014e+09, 1.019e+09]
    transmission: [0, 1, 1, 0]
    description: "VLA S-band tophat centered at 3 GHz"
  - name: "radio-6GHz"
    filterset: "radio"
    wavelength: [4.897e+08, 4.922e+08, 5.071e+08, 5.096e+08]
    transmission: [0, 1, 1, 0]
    description: "VLA C-band tophat centered at 6 GHz"
  - name: "radio-10GHz"
    filterset: "radio"
    wavelength: [2.938e+08, 2.953e+08, 3.043e+08, 3.058e+08]
    transmission: [0, 1, 1, 0]
    description: "VLA X-band tophat centered at 10 GHz"
  - name: "radio-15GHz"
    filterset: "radio"
    wavelength: [1.959e+08, 1.969e+08, 2.029e+08, 2.039e+08]
    transmission: [0, 1, 1, 0]
    description: "VLA Ku-band tophat centered at 15 GHz"
  - name: "radio-22GHz"
    filterset: "radio"
    wavelength: [1.335e+08, 1.342e+08, 1.383e+08, 1.39e+08]
    transmission: [0, 1, 1, 0]
    description: "VLA K-band tophat centered at 22 GHz"
  - name: "radio-33GHz"
    filterset: "radio"
    wavelength: [8.903e+07, 8.948e+07, 9.221e+07, 9.266e+07]
    transmission: [0, 1, 1, 0]
    description: "VLA Ka-band tophat centered at 33 GHz"
  - name: "radio-45GHz"
    filterset: "radio"
    wavelength: [6.529e+07, 6.562e+07, 6.762e+07, 6.795e+07]
    transmission: [0, 1, 1, 0]
    description: "VLA Q-band tophat centered at 45 GHz"
  # ATCA 3mm. The recommended CABB continuum pair for the 83-105 GHz band; no
  # VLA band reaches here, so without these an ATCA 3mm point has no bandpass.
  - name: "radio-93GHz"
    filterset: "radio"
    wavelength: [3.159e+07, 3.175e+07, 3.272e+07, 3.288e+07]
    transmission: [0, 1, 1, 0]
    description: "ATCA 3mm tophat centered at 93 GHz"
  - name: "radio-95GHz"
    filterset: "radio"
    wavelength: [3.093e+07, 3.108e+07, 3.203e+07, 3.219e+07]
    transmission: [0, 1, 1, 0]
    description: "ATCA 3mm tophat centered at 95 GHz"
  # Hard X-ray and gamma-ray monitors. Circulars quote a band inside the
  # instrument's full range, so the crosswalk keys on the instrument name.
  - name: "swiftbat"
    filterset: "bat"
    wavelength: [0.081, 0.08266, 0.8266, 0.8431]
    transmission: [0, 1, 1, 0]
    description: "Swift BAT tophat, 15-150 keV"
  - name: "fermigbm"
    filterset: "gbm"
    wavelength: [0.0003038, 0.00031, 1.55, 1.581]
    transmission: [0, 1, 1, 0]
    description: "Fermi GBM tophat, 8 keV to 40 MeV"
  - name: "fermilat"
    filterset: "lat"
    wavelength: [4.05e-08, 4.133e-08, 0.0006199, 0.0006323]
    transmission: [0, 1, 1, 0]
    description: "Fermi LAT tophat, 20 MeV to 300 GeV"
  - name: "konus"
    filterset: "konus"
    wavelength: [0.0006075, 0.0006199, 0.6199, 0.6323]
    transmission: [0, 1, 1, 0]
    description: "Konus-Wind tophat, 20 keV to 20 MeV"
  - name: "integralacs"
    filterset: "spiacs"
    wavelength: [0.006075, 0.006199, 0.1653, 0.1686]
    transmission: [0, 1, 1, 0]
    description: "INTEGRAL SPI-ACS tophat, 75 keV to 2 MeV"
  - name: "integralibis"
    filterset: "isgri"
    wavelength: [0.01215, 0.0124, 0.8266, 0.8431]
    transmission: [0, 1, 1, 0]
    description: "INTEGRAL IBIS/ISGRI tophat, 15-1000 keV"
  - name: "integraljemx"
    filterset: "jemx"
    wavelength: [0.3472, 0.3542, 4.133, 4.215]
    transmission: [0, 1, 1, 0]
    description: "INTEGRAL JEM-X tophat, 3-35 keV"
  - name: "caletcgbm"
    filterset: "cgbm"
    wavelength: [0.0006075, 0.0006199, 1.771, 1.807]
    transmission: [0, 1, 1, 0]
    description: "CALET CGBM tophat, 7 keV to 20 MeV"
  - name: "nustar"
    filterset: "nustar"
    wavelength: [0.1538, 0.1569, 4.133, 4.215]
    transmission: [0, 1, 1, 0]
    description: "NuSTAR tophat, 3-79 keV"
  - name: "maxigsc"
    filterset: "gsc"
    wavelength: [0.405, 0.4133, 6.199, 6.323]
    transmission: [0, 1, 1, 0]
    description: "MAXI GSC tophat, 2-30 keV"
  # SMA submillimeter bands.
  - name: "sma-230GHz"
    filterset: "sma"
    wavelength: [1.277e+07, 1.284e+07, 1.323e+07, 1.33e+07]
    transmission: [0, 1, 1, 0]
    description: "SMA 1.3mm tophat centered at 230 GHz"
  - name: "sma-345GHz"
    filterset: "sma"
    wavelength: [8.516e+06, 8.559e+06, 8.82e+06, 8.863e+06]
    transmission: [0, 1, 1, 0]
    description: "SMA 0.87mm tophat centered at 345 GHz"
  - name: "sma-400GHz"
    filterset: "sma"
    wavelength: [7.345e+06, 7.382e+06, 7.607e+06, 7.645e+06]
    transmission: [0, 1, 1, 0]
    description: "SMA 0.75mm tophat centered at 400 GHz"

user:
  default_role: "Full user"
  default_groups: []
  default_acls: []

ports:
  app: 5000 # This is the internal port
  # migration_manager port is already defined in baselayer config.yaml.defaults, but can be overridden here
  # migration_manager:
  notification_queue: 64610
  tns_retrieval_queue: 64810
  jpl_sbident_queue: 64820
  assistant: 64830

hosts:
  # Hostnames the application uses to reach its internal microservices. These
  # default to the loopback address, which is correct for the standard
  # single-host deployment where every service runs alongside the app. Override
  # a service's host to run it on a separate host/container (e.g. to scale a
  # microservice independently, or for a distributed/Kubernetes deployment).
  migration_manager: 127.0.0.1
  notification_queue: 127.0.0.1
  tns_retrieval_queue: 127.0.0.1
  jpl_sbident_queue: 127.0.0.1
  assistant: 127.0.0.1
  slack: 127.0.0.1

# JPL Scout NEO Target-of-Opportunity candidates, published by
# lsst-sssc/scout-alert-bridge. Leave `topic` unset to disable the service.
scout:
  topic: # e.g. lco.scout-neo-too-test
  kafka_server: kafka.scimma.org
  scimma_username: # SCiMMA/Kafka credentials; omit both for an unauthenticated broker
  scimma_password:
  group_ids: [] # groups the NEO candidates are saved to
  bot_user_id: # user recorded as saving the sources and authoring the annotations
  from_start: False # read the topic from the beginning (True) or from latest (False)
  # The bridge can publish under a `relaxed_test` filter mode that waives all but
  # the identity filters. Off by default so test traffic can't look like a trigger.
  allow_relaxed_test: False

gcn:
  server: gcn.nasa.gov
  # you can obtain a client_id and client_secret at https://gcn.nasa.gov/quickstart
  # you can set a group_id to remember the last GCN the app ingested from the stream
  client_group_id:
  client_id:
  client_secret:
  notice_types:
    # notices come in 2 formats: VOEVENT and JSON
    # You can get the notice types from the GCN website
    # First create some credentials at https://gcn.nasa.gov/quickstart/
    # Select the notices you are interested in, and the autogenerated
    # code will give you the notice types / topics to include here
    voevent:
      - gcn.notices.svom.voevent.grm
      - gcn.notices.svom.voevent.eclairs
      - gcn.classic.voevent.FERMI_GBM_FLT_POS
      - gcn.classic.voevent.FERMI_GBM_GND_POS
      - gcn.classic.voevent.FERMI_GBM_FIN_POS
      - gcn.classic.voevent.FERMI_GBM_SUBTHRESH
      - gcn.classic.voevent.SWIFT_BAT_GRB_POS_ACK
      - gcn.classic.voevent.SWIFT_XRT_POSITION
      # - gcn.classic.voevent.AMON_ICECUBE_COINC
      # - gcn.classic.voevent.AMON_ICECUBE_HESE
      - gcn.classic.voevent.ICECUBE_ASTROTRACK_GOLD
      - gcn.classic.voevent.ICECUBE_ASTROTRACK_BRONZE
      # - gcn.classic.voevent.MAXI_UNKNOWN
    json:
      - igwn.gwalert
      - gcn.notices.einstein_probe.wxt.alert
      - gcn.notices.swift.bat.guano
      # - gcn.notices.icecube.lvk_nu_track_search
  # Circulars are prose follow-up reports. Ingesting them keeps each event's
  # circular list and aliases current in real time, where the TACH backfill
  # (POST /gcn_event/<dateobs>/tach) only fills them in on demand and lags.
  # Circulars never create events; one whose event is unknown is skipped.
  circulars:
    enabled: false
    topic: gcn.circulars
    # Only used for the first circular of an event, before any alias exists to
    # match on; later ones match the designation this one writes. A designation
    # ("GRB 260604C") fixes the burst's UTC day but not its time, so the search
    # centres on noon that day and 12 hours spans exactly midnight to midnight.
    # Widen it only for bursts designated to a neighbouring day -- and note that
    # widening can lower the match rate, since a window holding more than one
    # event is ambiguous and is skipped rather than guessed at.
    window_hours: 12
  reject_tags: # reject notices with these tags (optional)
    - MDC
    - ECLAIRs-Catalog
  summary:
    acknowledgements:
      - The SkyPortal project acknowledges the generous support of The Gordon and Betty Moore Foundation.
  source_radius_threshold: 8.0 # max skymap cone radius to create a source, in arcmin

gcn_crossmatch:
  # Crossmatch broker alerts against active GCN localizations: for each event
  # still inside its window, query the alerts near its localization, keep the
  # ones genuinely inside the credible region, and raise them as candidates.
  #
  # What gets crossmatched is configured per SkyPortal Filter, not here: a
  # filter names the broker, the stream (hence survey and programids) and the
  # group that sees the candidates. Opt one in with
  #
  #   altdata:
  #     gcn_crossmatch:
  #       enabled: true
  #       # optional, same shape as DefaultGcnTag: restrict to matching events
  #       filters: {gcn_tags: ["Einstein Probe"]}
  #       # optional: any setting below, overridden for this filter alone
  #       delta_t_after: 7.0
  #
  # The values here are the defaults every such filter inherits.

  #
  # Annotations inherit the event's groups, so a restricted event's matches stay
  # as restricted as the event itself.
  enabled: False
  # Seconds between passes over the due (event, filter) pairs.
  poll_interval: 300
  # Events older than this many days are no longer crossmatched.
  max_event_age: 31.0
  # Minimum gap before an event is re-queried through the same filter. Events
  # are re-queried for as long as they are active because alerts keep arriving
  # after the trigger. Hourly is far faster than a survey revisits a field, and
  # keeps a month of active events well inside a broker's rate limit.
  recheck_interval_minutes: 60.0
  # Query window around the event time, in days.
  delta_t_before: 1.0
  delta_t_after: 31.0
  # Localizations bounding to a cone larger than this (degrees) are skipped:
  # the broker query would be impractically wide. Large GW skymaps land here.
  max_radius_deg: 5.0
  # Credible level of the stored contour used to bound non-cone localizations.
  credible_level: 90
  # Cumulative probability defining "inside" for the containment check.
  cumprob: 0.95
  # Cap on alerts returned per event per filter per pass.
  max_alerts: 500
  # After a broker answers 429, skip it entirely for this many minutes. Quotas
  # are per account and shared with the rest of the app, so retrying sooner
  # burns allowance that interactive users need. Lasair's window is an hour.
  rate_limit_backoff_minutes: 60.0
  # Also search the window *before* the event, once per event/broker. Alerts
  # there cannot be caused by the event, so they rule a candidate out: a
  # position already flaring last month is a variable, not a counterpart.
  # Recorded with archival: true on the annotation.
  archival: True
  archival_days: 31.0

einstein_probe:
  # Ingestion of unverified X-ray transient candidates from the Einstein Probe
  # data center (https://ep.bao.ac.cn). This is a proprietary, invitation-only
  # feed and is DISTINCT from the public gcn.notices.einstein_probe.wxt.alert
  # topic configured under gcn.notice_types.json above: the data center
  # publishes candidates earlier and with more detail, keyed by name+version,
  # and its dateobs is the observation start rather than the trigger time.
  # The two streams therefore produce separate GcnEvents for the same physical
  # transient; the EP name is recorded in aliases so they can be cross-linked.
  #
  # Access to the data center is by invitation. Contact Tomas Ahumada
  # (tahumada@astro.umd.edu) or Lin Yan (lyan@caltech.edu).
  enabled: False
  base_url: https://ep.bao.ac.cn/ep
  email:
  password:
  # Seconds between polls of the unverified-candidate list.
  poll_interval: 300
  # Events are restricted to these groups. Because GcnEvent.read is
  # group-scoped, leaving this empty would fall back to the sitewide public
  # group and publish the proprietary feed to every user -- so the service
  # refuses to start unless at least one group is named here.
  group_names:
    - Einstein Probe
  # Scale factor applied to the EP position error to size the cone
  # localization: radius = pos_err * radius_multiplier, in degrees.
  radius_multiplier: 1.0
  # Candidates older than this many days are ignored on startup, so that a
  # fresh deployment does not backfill the entire archive.
  max_event_age: 31.0

health_monitor:
  seconds_between_checks: 30.5
  allowed_downtime_seconds: 120
  allowed_times_down: 3
  request_timeout_seconds: 30
  # How long do we give apps after restart to become healthy
  startup_grace_seconds: 30

analysis_services:
  analysis_folder: persistentdata/analysis
  max_analysis_per_obj_per_user: 50
  sn_analysis_service:
    port: 6801
  ngsf_analysis_service:
    port: 7001
  spectral_cube_analysis_service:
    port: 7002
  openai_analysis_service:
    port: 7003
    summary:
      # set this global API key if the project
      # will pay for the OpenAI costs. Otherwise
      # individual users need to set their own key
      # in the user preferences
      # Get a global key at:
      #   https://platform.openai.com/account/api-keys
      api_key:
      temperature: 0.3
      max_tokens: 350
      top_p: 1.0
      frequency_penalty: 0.0
      model: o4-mini
      presence_penalty: 1.0
      prompt: Using markdown (including URL links), in one succinct (less than 250 words) paragraph written in the 3rd person summarize the following comments about this astronomical source.  If classifications and/or the redshift are given, then note those in the summary. This will be read by expert astrophysicists, so no need to explain known concepts and definitions.
    embeddings_store:
      summary:
        location: pinecone
        api_key:
        index_name: openai-skyportal-summary
        index_size: 1536
        model: text-embedding-3-small
        cloud: aws
        region: us-east-1

# Root for on-disk caches; everything under it is regenerable and safe to delete.
cache_folder: cache
comments_folder: persistentdata/comments
localizations_folder: persistentdata/localizations
photometric_series_folder: persistentdata/phot_series
photometric_series_autodelete: True

colors:
  classifications:
    classification:
      # A few examples that show up in the demo data. You can modify the config on deploy to fill out the colors and types you want.
      { "variable": "#3a87ad", "Time-domain Source": "#ff0000" }
    origin: { "SCoPe": "#3a87ad" }
  gcnTags:
    {
      "BNS": "#468847",
      "NSBH": "#b94a48",
      "BBH": "#333333",
      "GRB": "#f89406",
      "AMON": "#3a87ad",
      "Significant": "#8B008B",
      "retracted": "#ffffff",
    }

  summary_sources:
    - score: 0.9
      fw: bold
      col: green
    - score: 0.8
      fw: bold
      col: black
    - score: 0.7
      fw: normal
      col: black
    - score: 0.0
      fw: normal
      col: grey

docs:
  servers:
    - url: http://localhost:5000
      description: Development server
    - url: https://skyportal.io
      description: Production server
